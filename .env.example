# Copiá este archivo a ".env" (mismo directorio, junto a docker-compose.yml)
# y completá los valores reales. NUNCA subas el ".env" real a git.

# --- Base de datos ---
DB_PASSWORD=changeme-strong-password

# --- Seguridad ---
# Generá un secreto largo y aleatorio, ej: openssl rand -base64 48
JWT_SECRET=changeme-jwt-secret
JWT_EXPIRATION=900000

# --- Email (usado para verificación de cuenta y reset de password) ---
# Con Gmail necesitás una "contraseña de aplicación", no tu password normal.
# Para probar rápido sin cuenta real, se puede usar un SMTP de pruebas como Mailtrap.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=changeme@gmail.com
MAIL_PASSWORD=changeme-app-password

# --- URLs públicas (usadas en los links de los emails y en CORS) ---
# En producción, reemplazar por los dominios reales, ej:
# APP_BACKEND_URL=https://api.tudominio.com
# APP_FRONTEND_URL=https://tudominio.com
APP_BACKEND_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000

# --- Base de datos: modo de sincronización del schema ---
# "update" es cómodo para desarrollo. En producción usar "validate"
# (una vez que el schema esté estable) para que Hibernate nunca
# modifique la base sola.
DDL_AUTO=update
